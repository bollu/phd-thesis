\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{packages}[2026/07/15 Thesis package loading and theorem styling]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Encoding and language.
%% cam-thesis.cls already loads: graphicx, setspace, microtype, hyperref
%% (with colorlinks=false; recoloured via \hypersetup below), hypcap,
%% glossaries (via the `glossary` option) and makeidx (via `withindex`).
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\usepackage[english]{babel}
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{csquotes}

%% Let TeX stretch interword spacing on otherwise-overfull lines rather than
%% overrun the margin. This clears the paragraph-level overfull boxes; the
%% remaining single-line offenders (long \texttt identifiers, URLs) are handled
%% by targeted breaks.
\setlength{\emergencystretch}{3em}

%% microtype. cam-thesis.cls loads it bare, which gives protrusion but leaves
%% font expansion off; it is switched on by the \PassOptionsToPackage in
%% thesis.tex, which has to run before the class does. Expansion lets TeX scale
%% glyphs by a fraction of a percent to justify a line, so the
%% \emergencystretch above -- which pays for a tight line with visibly loose
%% interword spacing -- has to fire less often. It evens out page colour; it
%% does not change the page count, and it does not touch the 24 overfull boxes
%% (those are unbreakable \footnotesize Lean listing lines; see the zi4 note).
%%
%% Small caps are set at cap height and read cramped at their natural fit;
%% 40/1000em of tracking is the conventional remedy. NB this is tracking in
%% running text, not the letterspaced display headings that classicthesis
%% wanted and that the heading section below deliberately removes.
\SetTracking{encoding=*, shape=sc}{40}

%% Allow long URLs (\url, and hyperref-wrapped links) to break at any character
%% rather than overrun the margin; loaded after the class's hyperref.
\usepackage{xurl}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Fonts: Cochineal body, classicthesis styling, drop caps.
%%
%% Cochineal is a Crimson/Garamond-lineage oldstyle face chosen to stand in for
%% Adobe Sabon -- the typeface the Computer Laboratory recommends and which
%% Fraser's lock-freedom dissertation is set in (cf. cam-thesis.cls's commented
%% \rmdefault{psb}). Sabon itself is commercial and not in TeX Live; Cochineal
%% is the closest free match, and at this measure it reproduces Sabon's line
%% breaks essentially verbatim.
%%
%% [p,osf] = proportional oldstyle figures, matching the previous mathpazo
%% [sc,osf] setup; Cochineal supplies real small caps. newtxmath's `cochineal'
%% option gives math matched to the text face.
%%
%% NB: classicthesis defaults to loading mathpazo itself -- palatino=false
%% suppresses that. Do NOT load lmodern afterwards; it silently overrides the
%% roman family.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\usepackage[p,osf]{cochineal}
\usepackage[cochineal]{newtxmath}
%% dottedtoc: keep tocloft's dotted leaders and flush-right page numbers.
%% classicthesis's default replaces the leader with \hspace{1.5em} and sets
%% \cftparfillskip, which parks the number inline right after the title.
\usepackage[palatino=false,dottedtoc]{classicthesis}
%% classicthesis's 70pt margin chapter number is hard-wired to Palatino
%% oldstyle (pplj); repoint it at Cochineal oldstyle so it matches the body.
\DeclareFixedFont{\chapterNumber}{T1}{Cochineal-OsF}{m}{n}{70}
%% Leading. classicthesis's Palatino branch used to issue \linespread{1.05},
%% which silently overrode the \onehalfspacing that cam-thesis.cls applies --
%% so the thesis has always been set at ~15.2pt leading, not 1.5 spacing.
%% palatino=false removes that \linespread, which would let \onehalfspacing
%% take over (~17.9pt, ~8 pages longer). Set it explicitly instead: 1.08 gives
%% ~15.5pt, matching both the previous leading and Fraser's Sabon-set thesis,
%% and suits Cochineal's smaller x-height. NB: raise to \onehalfspacing if the
%% Board of Graduate Studies' 1.5-spacing rule has to be met literally.
\linespread{1.08}
%% Monospace: Inconsolata (zi4). The default Computer Modern typewriter is a
%% different colour and skeleton from Cochineal and reads as a foreign body in
%% running text; Inconsolata is humanist and narrow, which matters here because
%% Lean listings are set at \footnotesize in a 135mm measure and must not
%% overrun (they still do in ~24 places; those need shorter source lines).
%%   varqu -- upright (not curly) quotes, so 'x' in code is not a typographic
%%            apostrophe; matters for Lean's primed identifiers.
%%   varl  -- l with a tail, distinguishing it from 1 and I.
%%   scaled -- Inconsolata runs large against Cochineal's modest x-height.
%% NB: every Unicode maths glyph in listings (∀ α → ∧ ...) is remapped to a
%% real maths glyph by newunicodechar in macros.sty, so the mono face is never
%% asked to supply them and coverage is not a constraint here.
\usepackage[varqu,varl,scaled=0.95]{zi4}
% dropcaps:
% https://tex.stackexchange.com/questions/250474/how-to-use-fancy-dropcaps-with-pdflatex
%% Zallman: decorated initials whose flourish reads as ornament while the
%% letterform stays unambiguous at this size. Carrickc and GoudyIn are heavier
%% and go black against Cochineal's colour; Typocaps (the previous choice) is
%% too plain to be worth the indent it costs.
\usepackage{Zallman,lettrine}
\renewcommand\LettrineFontHook{\Zallmanfamily}
%% Three lines rather than lettrine's default two: at two lines the ornament is
%% too small to resolve.
\setcounter{DefaultLines}{3}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Page geometry.
%% classicthesis (above) clamps the text block to a narrow 336pt (~118mm)
%% \areaset measure. We widen it to ~135mm -- classicthesis's own recommended
%% width for a 12pt oldstyle body.
%%
%% The margins are ASYMMETRIC but NOT MIRRORED: 20mm on the left and 55mm on
%% the right of EVERY page, recto and verso alike. This is the point of
%% `twoside=false' below -- geometry would otherwise swap the two on verso
%% pages, which is the conventional book arrangement but makes the text block
%% shuffle left and right as you page through the PDF.
%%
%% Consequences of the fixed wide margin:
%%   * The wide margin is always the right-hand one, so margin captions (see
%%     the caption section below) and classicthesis's 70pt chapter number
%%     always appear on the same side, and the running heads use the recto
%%     arrangement on both parities rather than alternating.
%%   * 55 - 6 (sep) - 5 (slack to the trimmed edge) = 44mm (~125pt) of caption
%%     column, about 28 characters at \footnotesize. That is a readable
%%     measure for a caption; the 34mm a symmetric layout could afford was not.
%%   * The binding edge alternates between the 20mm and the 55mm side. 20mm is
%%     the usual stated minimum for a bound thesis, so this is the floor: do
%%     not take the left margin below it.
%%
%% Measure: 210 - 20 - 55 = 135mm, classicthesis's own recommended width for a
%% 12pt oldstyle body. Captions no longer sit inside the measure, so the body
%% column reads wider than the number suggests.
%%
%% Head and foot at 25mm rather than 30mm: 10mm more text per page, about four
%% lines, which is the single cheapest thing that can be done about density.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\usepackage{geometry}
\geometry{a4paper, twoside=false, left=20mm, right=55mm, top=25mm, bottom=25mm,
          marginparwidth=44mm, marginparsep=6mm}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Heading style: title case, not caps.
%%
%% classicthesis sets chapter titles in letterspaced FULL CAPS
%% (\spacedallcaps) and section titles in letterspaced small caps
%% (\spacedlowsmallcaps). Both are replaced here by title case set in
%% Cochineal. Caps at display size read as shouting, letterspacing makes a
%% long title ("Verifying Peephole Rewriting in SSA Compiler IRs") hard to
%% scan, and caps throw away the ascender/descender pattern that makes a
%% heading recognisable at a glance.
%%
%% Only the font applied to the title text changes. The marginal chapter
%% number, the rule under the chapter title, and all of titlesec's spacing are
%% classicthesis's and are reproduced verbatim.
%%
%% Run-in \paragraph headings go the same way. classicthesis letterspaces them
%% as small caps, which at run-in size reads as PUBLICATIONS AND ATTRIBUTION --
%% indistinguishable from caps to anyone not looking for it. They are set in
%% bold title case instead: something has to separate the head from the
%% sentence it introduces, and with the document's only other weights being
%% roman and italic (italic is already \emph and the subsection titles), bold
%% is the one signal left that is unambiguous at this size.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% WIDTH. Several titles are longer than the 135mm measure -- "A Unified
%% Presentation of Zero, One, Many Width Parametric Bitvector Theory" wants
%% 168mm at \large, and no sane measure would hold it -- so they wrapped onto a
%% second line. Headings are therefore allowed to run the full width of the
%% page, measure plus the margin column, via a negative right-spacing in
%% \titlespacing below. The margin is empty at a heading (a caption there would
%% belong to a float, and floats do not start level with a heading), and the
%% overhang lines the heading up with the chapter number, which already lives
%% out there.
%%
%% The rule under a chapter title deliberately does NOT follow: it is written
%% as an explicit \rule{\textwidth} rather than \titlerule, which would inherit
%% the widened title block and run 50mm into the margin.
\newlength{\cam@titleoverhang}
\setlength{\cam@titleoverhang}{\marginparsep}
\addtolength{\cam@titleoverhang}{\marginparwidth}
%% classicthesis puts \chapter in titlesec's `top' title class, and for that
%% class titlesec ignores the right-spacing spec -- so the negative overhang
%% that widens section titles does nothing here, and "Verifying Peephole
%% Rewriting in SSA Compiler IRs" (145mm at \LARGE) still broke over two lines.
%% Set the width on the title box directly instead.
\newcommand{\cam@chaptertitle}[1]{%
  \parbox[t]{\dimexpr\textwidth+\cam@titleoverhang\relax}{\raggedright\LARGE #1}}
\titleformat{\chapter}[display]%
  {\relax}%
  {\mbox{}\oldmarginpar{\vspace*{-3\baselineskip}\color{CTsemi}%
                        \chapterNumber\thechapter}}{0pt}%
  {\cam@chaptertitle}%
  [\normalsize\vspace*{.8\baselineskip}\rule{\textwidth}{0.4pt}]%
\titleformat{\section}
    {\relax}{\large\thesection}{1em}{\large}
\titleformat{\subsection}
    {\relax}{\thesubsection}{1em}{\normalsize\itshape}
\titleformat{\subsubsection}
    {\relax}{\thesubsubsection}{1em}{\normalsize\itshape}
\titleformat{\paragraph}[runin]
    {\normalfont\normalsize\bfseries}{\theparagraph}{0pt}{}

%% Spacing. The negative right-spec is the overhang described above; the
%% before/after values are tightened from classicthesis's (1.25/1 baselineskip
%% at section level) because a 12pt body at this leading already separates a
%% heading from its text perfectly well with less.
\titlespacing*{\chapter}{0pt}{1\baselineskip}{1\baselineskip}[-\cam@titleoverhang]
\titlespacing*{\section}{0pt}{1\baselineskip}{0.5\baselineskip}[-\cam@titleoverhang]
\titlespacing*{\subsection}{0pt}{0.9\baselineskip}{0.4\baselineskip}[-\cam@titleoverhang]
\titlespacing*{\subsubsection}{0pt}{0.8\baselineskip}{0.3\baselineskip}[-\cam@titleoverhang]
\titlespacing*{\paragraph}{0pt}{0.8\baselineskip}{1em}

%% Contents entries follow the headings. classicthesis sets chapter lines in
%% spaced small caps, which would be the only caps left in the document.
\renewcommand{\cftchappresnum}{\normalfont}
\renewcommand{\cftchapaftersnumb}{\normalfont}
\renewcommand{\cftchapfont}{\normalfont}

%% Running heads. Two changes to classicthesis's setup:
%%   1. The marks are plain roman rather than spaced small caps, to match the
%%      headings they name.
%%   2. Both parities get the recto arrangement -- title flush right, page
%%      number hung out past it -- because the wide margin is on the right of
%%      every page (see the geometry note above). Keeping classicthesis's
%%      alternation would swing the page number into the 25mm side on versos
%%      and read as a mistake rather than as a spread.
\renewcommand{\chaptermark}[1]{\markboth{#1}{#1}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\enspace #1}}
\lehead{}\lohead{}
\rehead{\mbox{\hfil{\headmark}\rlap{\small\kern2em\pagemark}}}
\rohead{\mbox{\hfil{\headmark}\rlap{\small\kern2em\pagemark}}}
%% Chapter-opening pages use the `plain' variant: no head, page number in the
%% foot. Pin it to the right foot on both parities for the same reason.
\lefoot[]{}\lofoot[]{}
\refoot[\small\pagemark]{}\rofoot[\small\pagemark]{}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Vertical density.
%%
%% The page was reading loose. The levers, in rough order of what each buys:
%%
%%   * 25mm head/foot instead of 30mm (see geometry above): about four more
%%     lines a page.
%%   * \raggedbottom. report's twoside default is \flushbottom, which pads
%%     every short page out to full depth by stretching the glue around
%%     headings, floats and displays -- so a page one line short does not end
%%     one line short, it comes out uniformly airy throughout. \raggedbottom
%%     leaves the slack at the foot, where nobody sees it.
%%   * Float separations. LaTeX's defaults suit an article with two figures;
%%     this document has about thirty, each fencing itself off with 20pt of
%%     white above and below.
%%   * List and display skips, and the heading spacing set with \titlespacing
%%     above.
%%
%% NOT changed: \linespread, still 1.08 (~15.5pt on a 12pt body). It is the
%% biggest remaining lever -- 1.0 would take roughly 7% off the page count --
%% but the leading is a deliberate reading of the Board of Graduate Studies'
%% 1.5-spacing rule (see the note in the font section) and is not something to
%% trim as a side effect of tightening the page.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\raggedbottom
\setlength{\textfloatsep}{12pt plus 4pt minus 3pt}
\setlength{\floatsep}{10pt plus 3pt minus 2pt}
\setlength{\intextsep}{12pt plus 3pt minus 2pt}
\setlength{\dblfloatsep}{10pt plus 3pt minus 2pt}
\setlength{\dbltextfloatsep}{12pt plus 4pt minus 3pt}
\setlength{\abovedisplayskip}{8pt plus 3pt minus 4pt}
\setlength{\belowdisplayskip}{8pt plus 3pt minus 4pt}
\setlength{\abovedisplayshortskip}{2pt plus 3pt}
\setlength{\belowdisplayshortskip}{5pt plus 3pt minus 3pt}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Footnote measure: footnotes run out into the wide outer margin.
%%
%% The body measure is 135mm and the outer margin is 50mm of caption column
%% (see the geometry note above), which at the foot of the page is almost
%% always empty. Footnotes set to the body measure therefore wrap after a line
%% and a bit, so three one-sentence notes on a page come out as six lines, half
%% of them stubs.
%%
%% Give footnotes 185mm instead -- measure + \marginparsep + \marginparwidth,
%% flush with the right edge of the margin captions. A one-sentence note then
%% fits on one line.
%%
%% Mechanism: \@footnotetext (footmisc's \FN@footnotetext, which classicthesis
%% loads, or hyperref's wrapper around it) sets \hsize\columnwidth and builds
%% the insertion there and then, so widening \columnwidth in a group around the
%% call is enough and no internals need patching. \footnoterule is emitted
%% later by the output routine and keeps its body-measure length, which is what
%% we want: the rule marks the column, not the note.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\let\cam@orig@footnotetext\@footnotetext
\long\def\@footnotetext#1{%
  \begingroup
    \advance\columnwidth\dimexpr\marginparsep+\marginparwidth\relax
    \cam@orig@footnotetext{#1}%
  \endgroup}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Contents pages.
%% The body measure (135mm) is too narrow for this thesis's long section
%% titles, so ToC entries wrapped onto a second line -- and with the dotted
%% leaders enabled above, a wrapped title also costs a whole leader run.
%%
%% The ToC needs no wide outer margin (no \marginpar chapter numbers there), so
%% give it its own near-symmetric geometry: ~165mm of measure, +30mm over the
%% body. Geometry is restored immediately afterwards, so only the contents
%% pages are affected. NB: \@tocrmarg is deliberately left at tocloft's default
%% -- it reserves the column the flush-right page numbers live in.
%%
%% Depth: chapters and sections only. cam-thesis.cls sets tocdepth to 3,
%% which pulls x.y.z subsections and deeper into the contents. Set locally so
%% only the ToC is pruned -- secnumdepth is untouched, so subsections are
%% still numbered in the body.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\let\cam@origtoc\tableofcontents
\renewcommand{\tableofcontents}{%
  %% Left margin matches the body's 20mm so the text block's left edge does not
  %% move when you page from the contents into the thesis.
  \newgeometry{a4paper, twoside=false, left=20mm, right=20mm, top=25mm,
               bottom=25mm, marginparwidth=12mm, marginparsep=4mm}%
  \setcounter{tocdepth}{1}%
  \cam@origtoc
  \restoregeometry
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Chapter-opening epigraphs (\epigraph{quote}{author}).
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\usepackage{epigraph}
\setlength{\epigraphwidth}{\textwidth}
\setlength{\epigraphrule}{0pt}       % no rule under the quote
\setlength{\beforeepigraphskip}{1\baselineskip}
\setlength{\afterepigraphskip}{1.4\baselineskip}
\renewcommand{\textflush}{flushleft}     % ragged-right quote body
\renewcommand{\sourceflush}{flushleft}
%% Attribution line. Out of the box, epigraph sets the source at the same size
%% and weight as the quote and leaves only 1ex above it, so the attribution
%% reads as one more line of the quotation. Two changes, both in the package's
%% internals so that \epigraph, \qitem and the epigraphs environment all get
%% them:
%%
%%   \@epitext   -- open the gap under the quote from 1ex to 0.6\baselineskip.
%%   \@episource -- drop one size step and prefix an em dash. The source stays
%%                  upright roman rather than going italic or small caps, so
%%                  that \emph{...} in the source argument (several chapters
%%                  italicise the work's title there) still contrasts, and so
%%                  that author names are not spaced out by small caps.
\makeatletter
\renewcommand{\@epitext}[1]{%
  \begin{minipage}{\epigraphwidth}\begin{\textflush} #1\\
    \ifdim\epigraphrule>\z@ \@epirule \else \vspace*{0.6\baselineskip} \fi
  \end{\textflush}\end{minipage}}
\renewcommand{\@episource}[1]{%
  \begin{minipage}{\epigraphwidth}\begin{\sourceflush}
    \footnotesize\textemdash\,#1%
  \end{\sourceflush}\end{minipage}}
\makeatother

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Colours. dvipsnames is passed via \PassOptionsToPackage in thesis.tex.
%%
%% The document has ONE accent colour. Everything that is not black body text
%% -- internal links, citations, URLs -- is set in Accent; the only other
%% non-black elements are classicthesis's grey chapter numbers and the pale
%% theorem/code tints below. Three saturated hues (the previous NavyBlue /
%% Green / BrickRed) fight each other and fight Cochineal's warm black.
%%
%% Accent is an oxblood that sits in Cochineal's warm register. AccentDark is
%% for the rare case where a link needs to read as text rather than as a link.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\usepackage{xcolor}
\usepackage{soul}
\definecolor{Accent}{HTML}{8A2B2B}
\definecolor{AccentDark}{HTML}{5C1D1D}
%% Inline code tint. Display listings are untinted (see macros.sty), but inline
%% code keeps a background so that an identifier dropped into running prose is
%% visibly a piece of code.
%%
%% The point of doing it here is CONSISTENCY. Inline code was marked up two
%% different ways depending on the chapter: \leaninline (Lean-lexed, tinted)
%% in the mono-width chapter, ~60 uses, and plain \texttt (no tint) everywhere
%% else, ~620 uses. Same thing on the page, two different appearances. Both now
%% go through the same tint.
%%
%% \fboxsep is pulled in to 1pt: \colorbox's 3pt default puts a visible slab
%% around a two-character identifier and pushes the surrounding words apart.
%%
%% NB \makeatletter: this sits after the epigraph block's \makeatother, so `@'
%% is back to catcode 12 here and \cam@... would tokenise as \cam followed by
%% letters. Same trap at the end of macros.sty.
\colorlet{CodeBg}{black!5}
\makeatletter
\newcommand{\cam@codetint}[1]{%
  {\setlength{\fboxsep}{1pt}\colorbox{CodeBg}{#1}}}
\makeatother

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Enumerations and tables.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\usepackage{calc}
\usepackage[shortlabels]{enumitem}
%% Tighter list indentation. LaTeX's default \leftmargini is 2.5em, which at
%% this measure pushes list bodies a long way in from the text block and eats
%% the measure again at every nesting level.
%%
%% leftmargin=* sizes the indent to the label itself (label width + labelsep)
%% rather than to a fixed em value: bullets and numbers then sit flush with the
%% surrounding text margin, continuation lines align under the item text, and
%% nested levels stay compact instead of compounding. Applies to itemize,
%% enumerate and description at every depth.
\setlist{leftmargin=*, labelsep=0.5em,
         topsep=0.4\baselineskip, itemsep=0.25\baselineskip,
         parsep=0pt, partopsep=0pt}
%% Top-level itemize costs no horizontal space at all: the bullet is \llap'ed
%% into the left margin, so item text -- first and continuation lines alike --
%% sits flush with the surrounding body text. This is what the publications
%% list in the introduction wants. Nested itemize, enumerate and description
%% keep the leftmargin=* above, since outdenting numbers or long description
%% labels into the margin reads badly.
\setlist[itemize,1]{leftmargin=0pt, labelwidth=0pt, labelsep=0pt,
                    itemindent=0pt, label=\llap{\textbullet\hspace{0.5em}}}
\usepackage{booktabs}
\usepackage{multirow}
\usepackage{colortbl}
\usepackage{longtable}
\usepackage[width=.8\textwidth]{caption}
\captionsetup[table]{skip=1em}
\usepackage{subcaption}
\usepackage{wrapfig}
\newcommand{\ra}[1]{\renewcommand{\arraystretch}{#1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Margin captions.
%%
%% Figure and table captions are set in the wide right-hand margin rather than
%% under the float, so the figure anchors the page, the caption stops
%% interrupting the column, and the margin earns its width.
%%
%% MECHANISM. The obvious implementation -- \marginnote (or the sidenotes
%% package, which wraps it) at the point of \caption -- was tried and does not
%% work here, for two independent reasons:
%%
%%   1. \marginnote has no collision avoidance. Two floats on one page put two
%%      captions in the margin at their own vertical positions and the taller
%%      one simply prints through the one below it. Several of this thesis's
%%      captions run to 60-100 words, which is 15-20 lines in a 44mm column,
%%      so this is the common case rather than the corner case.
%%   2. The caption lands at the BOTTOM of the float (where \caption appears in
%%      the source) and then hangs down past it, rather than starting level
%%      with the top of the figure.
%%
%% Instead the caption is made part of the float. The float body is captured
%% in a box, the caption is typeset into a second box \marginparwidth wide, and
%% the two are set side by side in an \hbox that overhangs into the margin.
%% Consequences, all of them the point of doing it this way:
%%   * Captions are top-aligned with their figure for free.
%%   * The caption travels with the float, so it always sits level with the
%%     figure it describes, wherever LaTeX places it.
%%
%% The caption box is zeroed before assembly (see \cam@endfloat), so the
%% float's height is the BODY's height alone: a caption taller than its
%% figure hangs on down the margin while body text flows in the main column
%% beside it, instead of the float reserving a caption-sized blank. The
%% price is that nothing structurally prevents a long caption from running
%% past the page bottom, or into the margin caption of another float placed
%% closely below -- LaTeX will not warn about either, so pages where a
%% caption clearly outruns its figure deserve a visual check.
%%
%% \longcaption is the escape hatch: it is the original \caption, set under the
%% float at full measure. Use it where a caption is long enough that hanging
%% it down a 44mm margin column would collide with the page bottom or a
%% neighbouring float's caption.
%%
%% SUBCAPTIONS. \subcaption text is routed into the same margin column, below
%% the main caption, in subfloat order. The sub-label ((a), (b), ...) is still
%% printed under the subfloat it belongs to, so the figure remains readable on
%% its own and the reader can pair label with description. The subcaption is
%% typeset into its box AT THE POINT OF USE, not deferred, so that a \label
%% inside the subcaption argument -- which is how this thesis writes them,
%% \caption{\label{fig:x} ...} -- still sees the correct subfigure counter.
%%
%% EXCLUSIONS. wrapfigure, wraptable and longtable keep ordinary captions:
%% all three do their own column surgery and do not survive being boxed.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\DeclareCaptionStyle{margincaption}{font=footnotesize,
                                    justification=raggedright,
                                    singlelinecheck=false,
                                    width=\marginparwidth,
                                    skip=0pt}
\makeatletter
\let\cam@origcaption\caption
\newcommand{\longcaption}{\cam@origcaption}

\newsavebox{\cam@bodybox}
\newsavebox{\cam@capbox}
\newsavebox{\cam@subbox}
\newsavebox{\cam@tmpbox}
\newif\ifcam@hascap
\newif\ifcam@hassub

%% Typeset #1 into \cam@tmpbox as a \marginparwidth-wide column.
%%
%% \caption calls \refstepcounter, which sets \@currentlabel and hyperref's and
%% cleveref's equivalents LOCALLY. Typesetting the caption inside a box means
%% that group closes before the \label that follows \caption in the source is
%% read -- this thesis writes both \caption{...}\label{...} and
%% \caption{\label{...} ...} -- so a trailing \label would point at whatever
%% was current before the float (in practice the enclosing section, which is
%% why \cref{fig:...} silently rendered as a section reference). Carry the
%% label state out of the box by hand.
\providecommand{\@currentlabelname}{}
\providecommand{\@currentHref}{}
\providecommand{\cref@currentlabel}{}
\providecommand{\@currentcounter}{}
\newcommand{\cam@mkcolbox}[1]{%
  \global\setbox\cam@tmpbox=\vbox{%
    \hsize=\marginparwidth
    \linewidth=\hsize \columnwidth=\hsize
    \@parboxrestore
    \captionsetup{style=margincaption}%
    #1%
    \global\let\cam@lbl@label\@currentlabel
    \global\let\cam@lbl@name\@currentlabelname
    \global\let\cam@lbl@href\@currentHref
    \global\let\cam@lbl@cref\cref@currentlabel
    \global\let\cam@lbl@ctr\@currentcounter}%
  \let\@currentlabel\cam@lbl@label
  \let\@currentlabelname\cam@lbl@name
  \let\@currentHref\cam@lbl@href
  \let\cref@currentlabel\cam@lbl@cref
  \let\@currentcounter\cam@lbl@ctr}

%% Caption dispatch. Both levels come through \caption, but telling them apart
%% is not as simple as reading \@captype: subcaption marks a subfloat with a
%% caption-package flag (\captionsetup{subtype}) and leaves \@captype at
%% `figure', so inside a subfigure \@captype still says figure. Hence the
%% explicit \ifcam@insub, set by the subfloat patch below. It is set inside the
%% subfloat's minipage group, so it unsets itself when the subfloat ends.
\newcommand{\cam@caption}{%
  \@ifnextchar[{\cam@caption@opt}{\cam@caption@noopt}}
\def\cam@caption@opt[#1]#2{\cam@caption@do{#1}{#2}}
\def\cam@caption@noopt#1{\cam@caption@do{}{#1}}
%% Both emitters call the \caption that was in force at the point they hook,
%% NOT the \cam@origcaption saved in the preamble. The caption package
%% specialises \caption per float (and again per subfloat), and part of that
%% specialisation decides whether the float's counter still needs stepping.
%% Calling the preamble copy bypasses it, and the float counter gets stepped a
%% second time: subfloats of Figure 3.2 came out labelled 3.1a, 3.1b, and every
%% figure after a subfigured one was numbered one too high.
\newcommand{\cam@emitcaption}[2]{%
  \ifstrempty{#1}{\cam@floatcmd{#2}}{\cam@floatcmd[#1]{#2}}}
\newif\ifcam@insub
\newcommand{\cam@caption@do}[2]{%
  \ifcam@insub
    \cam@subcaption@do{#1}{#2}%
  \else
    \ifthenelse{\equal{\@captype}{figure} \OR \equal{\@captype}{table}}%
      {\cam@mkcolbox{\cam@emitcaption{#1}{#2}}%
       \global\setbox\cam@capbox=\box\cam@tmpbox
       \global\cam@hascaptrue}%
      {\cam@emitcaption{#1}{#2}}%
  \fi}

%% Subcaption: the description is boxed for the margin column; only the label
%% is printed under the subfloat it belongs to.
\newcommand{\cam@emitsubcaption}[2]{%
  \ifstrempty{#1}{\cam@subcmd{#2}}{\cam@subcmd[#1]{#2}}}
\newcommand{\cam@subcaption@do}[2]{%
  \cam@mkcolbox{\cam@emitsubcaption{#1}{#2}}%
  \ifcam@hassub
    \global\setbox\cam@subbox=\vbox{\unvbox\cam@subbox
                                    \vskip0.5\baselineskip
                                    \unvbox\cam@tmpbox}%
  \else
    \global\setbox\cam@subbox=\box\cam@tmpbox
    \global\cam@hassubtrue
  \fi
  %% The counter was stepped inside the box above (LaTeX counters are global),
  %% so \thesubfigure is now this subfloat's letter.
  \par\centering{\footnotesize(\thesubfigure)}\par}

%% Float body capture and side-by-side assembly.
%%
%% \cam@startfloat CANNOT be installed with \AtBeginEnvironment{figure}: that
%% hook fires before \@float has looked ahead for the [htb] optional argument,
%% so the hook's tokens are what \@ifnextchar sees. The placement specifier is
%% then typeset as literal text and \@xfloat runs inside our \vbox, where it
%% dies with "Not in outer par mode". Appending to \@xfloat instead puts the
%% hook inside the float box, after \@floatboxreset, which is exactly where the
%% body starts. \@captype is set by then, so the same hook serves every float
%% class and can decline the ones it should not touch.
\newif\ifcam@boxed
\newcommand{\cam@startfloat}{%
  \global\cam@boxedfalse
  \ifthenelse{\equal{\@captype}{figure} \OR \equal{\@captype}{table}}%
    {\global\cam@boxedtrue
     \global\cam@hascapfalse
     \global\cam@hassubfalse
     \let\cam@floatcmd\caption
     \let\caption\cam@caption
     \setbox\cam@bodybox=\vbox\bgroup
       \hsize=\textwidth
       \linewidth=\hsize \columnwidth=\hsize
       \@parboxrestore}%
    {}}
\newcommand{\cam@endfloat}{%
  \ifcam@boxed
    \egroup
    \ifcam@hascap
      \global\setbox\cam@capbox=\vbox{%
        \unvbox\cam@capbox
        \ifcam@hassub \vskip0.6\baselineskip \unvbox\cam@subbox \fi}%
    \else
      \ifcam@hassub
        \global\setbox\cam@capbox=\box\cam@subbox
        \global\cam@hascaptrue
      \fi
    \fi
    \noindent
    \ifcam@hascap
      %% The caption box is zeroed (ht = dp = 0) so it hangs in the margin
      %% from the float's top edge without contributing to the float's
      %% height: a caption taller than its figure no longer holds blank
      %% space in the main column, and body text flows on directly below
      %% the figure, beside the caption's tail. The content still prints at
      %% the same position -- box dimensions only affect layout around the
      %% box, not its contents.
      \setbox\cam@tmpbox=\vtop{\unvbox\cam@capbox}%
      \ht\cam@tmpbox=0pt
      \dp\cam@tmpbox=0pt
      %% \hss absorbs the overhang into the margin without an overfull warning.
      \hbox to\textwidth{\vtop{\unvbox\cam@bodybox}%
                         \hskip\marginparsep
                         \box\cam@tmpbox\hss}%
    \else
      \unvbox\cam@bodybox
    \fi
    \global\cam@boxedfalse
  \fi}

%% Same story one level down. \AtBeginEnvironment{subfigure} is no good for
%% the same reason it was no good for figure: subcaption's environment looks
%% ahead for the [b] and {width} arguments, so the hook's tokens arrive before
%% the minipage exists -- and the minipage's \@parboxrestore then puts \caption
%% back to the caption package's own. \subcaption@iiminipage is the point after
%% the minipage has been opened, which is where the rebinding survives.
\apptocmd{\@xfloat}{\cam@startfloat}{}{%
  \PackageWarning{packages}{Could not patch \string\@xfloat;
                            margin captions disabled}}
\apptocmd{\subcaption@iiminipage}{%
  \cam@insubtrue
  %% \caption inside a subfloat is NOT the top-level \caption: subcaption
  %% installs a subfloat-aware one that numbers against the subfigure counter.
  %% Save it before overwriting, and call the saved one to typeset the
  %% subcaption -- calling the top-level \caption instead silently numbers
  %% every subfloat as a new figure ("Figure (3)" for what should be "(b)").
  \let\cam@subcmd\caption
  \let\caption\cam@caption}{}{%
  \PackageWarning{packages}{Could not patch \string\subcaption@iiminipage;
                            subcaptions stay under their subfloat}}
\AtBeginDocument{%
  \AtEndEnvironment{figure}{\cam@endfloat}%
  \AtEndEnvironment{figure*}{\cam@endfloat}%
  \AtEndEnvironment{table}{\cam@endfloat}%
  \AtEndEnvironment{table*}{\cam@endfloat}%
  \AtBeginEnvironment{wrapfigure}{\let\caption\cam@origcaption}%
  \AtBeginEnvironment{wraptable}{\let\caption\cam@origcaption}%
  \AtBeginEnvironment{longtable}{\let\caption\cam@origcaption}%
}
\makeatother

