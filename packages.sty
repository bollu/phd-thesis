%% Tighter list indentation. LaTeX's default \leftmargini is 2.5em, which at
%% this measure pushes list bodies a long way in from the text block and eats
%% the measure again at every nesting level.
%%
%% leftmargin=* sizes the indent to the label itself (label width + labelsep)
%% rather than to a fixed em value: bullets and numbers then sit flush with the
%% surrounding text margin, continuation lines align under the item text, and
%% nested levels stay compact instead of compounding. Applies to itemize,
%% enumerate and description at every depth.
\setlist{leftmargin=*, labelsep=0.5em}
%% Top-level itemize costs no horizontal space at all: the bullet is \llap'ed
%% into the left margin, so item text -- first and continuation lines alike --
%% sits flush with the surrounding body text. This is what the publications
%% list in the introduction wants. Nested itemize, enumerate and description
%% keep the leftmargin=* above, since outdenting numbers or long description
%% labels into the margin reads badly.
\setlist[itemize,1]{leftmargin=0pt, labelwidth=0pt, labelsep=0pt,
                    itemindent=0pt, label=\llap{\textbullet\hspace{0.5em}}}
