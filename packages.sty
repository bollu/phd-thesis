%% Let TeX stretch interword spacing on otherwise-overfull lines rather than
%% overrun the margin. This clears the paragraph-level overfull boxes; the
%% remaining single-line offenders (long \texttt identifiers, URLs) are handled
%% by targeted breaks.
\setlength{\emergencystretch}{3em}

%% Allow long URLs (\url, and hyperref-wrapped links) to break at any character
%% rather than overrun the margin; loaded after the class's hyperref.
