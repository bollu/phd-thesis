%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Margin captions.
%%
%% Figure and table captions are set in the wide right-hand margin rather than
%% under the float, so the figure anchors the page, the caption stops
%% interrupting the column, and the margin earns its width.
%%
%% MECHANISM. The obvious implementation -- \marginnote (or the sidenotes
%% package, which wraps it) at the point of \caption -- was tried and does not
%% work here, for two independent reasons:
%%
%%   1. \marginnote has no collision avoidance. Two floats on one page put two
%%      captions in the margin at their own vertical positions and the taller
%%      one simply prints through the one below it. Several of this thesis's
%%      captions run to 60-100 words, which is 15-20 lines in a 44mm column,
%%      so this is the common case rather than the corner case.
%%   2. The caption lands at the BOTTOM of the float (where \caption appears in
%%      the source) and then hangs down past it, rather than starting level
%%      with the top of the figure.
%%
%% Instead the caption is made part of the float. The float body is captured
%% in a box, the caption is typeset into a second box \marginparwidth wide, and
%% the two are set side by side in an \hbox that overhangs into the margin.
%% Consequences, all of them the point of doing it this way:
%%   * The float's height is max(body, caption), so LaTeX's ordinary float
%%     placement keeps captions apart. Overlap is structurally impossible.
%%   * Captions are top-aligned with their figure for free.
%%   * A caption too long to fit beside its figure makes the float tall, and
%%     LaTeX moves it to a page where it fits, rather than overprinting.
%%
%% \longcaption is the escape hatch: it is the original \caption, set under the
%% float at full measure. Use it where a caption is long enough that a 44mm
%% column would turn the float into a full page.
%%
%% SUBCAPTIONS. \subcaption text is routed into the same margin column, below
%% the main caption, in subfloat order. The sub-label ((a), (b), ...) is still
%% printed under the subfloat it belongs to, so the figure remains readable on
%% its own and the reader can pair label with description. The subcaption is
%% typeset into its box AT THE POINT OF USE, not deferred, so that a \label
%% inside the subcaption argument -- which is how this thesis writes them,
%% \caption{\label{fig:x} ...} -- still sees the correct subfigure counter.
%%
%% EXCLUSIONS. wrapfigure, wraptable and longtable keep ordinary captions:
%% all three do their own column surgery and do not survive being boxed.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\DeclareCaptionStyle{margincaption}{font=footnotesize,
                                    justification=raggedright,
                                    singlelinecheck=false,
                                    width=\marginparwidth,
                                    skip=0pt}
\makeatletter
\let\cam@origcaption\caption
\newcommand{\longcaption}{\cam@origcaption}

\newsavebox{\cam@bodybox}
\newsavebox{\cam@capbox}
\newsavebox{\cam@subbox}
\newsavebox{\cam@tmpbox}
\newif\ifcam@hascap
\newif\ifcam@hassub

%% Typeset #1 into \cam@tmpbox as a \marginparwidth-wide column.
%%
%% \caption calls \refstepcounter, which sets \@currentlabel and hyperref's and
%% cleveref's equivalents LOCALLY. Typesetting the caption inside a box means
%% that group closes before the \label that follows \caption in the source is
%% read -- this thesis writes both \caption{...}\label{...} and
%% \caption{\label{...} ...} -- so a trailing \label would point at whatever
%% was current before the float (in practice the enclosing section, which is
%% why \cref{fig:...} silently rendered as a section reference). Carry the
%% label state out of the box by hand.
\providecommand{\@currentlabelname}{}
\providecommand{\@currentHref}{}
\providecommand{\cref@currentlabel}{}
\providecommand{\@currentcounter}{}
\newcommand{\cam@mkcolbox}[1]{%
  \global\setbox\cam@tmpbox=\vbox{%
    \hsize=\marginparwidth
    \linewidth=\hsize \columnwidth=\hsize
    \@parboxrestore
    \captionsetup{style=margincaption}%
    #1%
    \global\let\cam@lbl@label\@currentlabel
    \global\let\cam@lbl@name\@currentlabelname
    \global\let\cam@lbl@href\@currentHref
    \global\let\cam@lbl@cref\cref@currentlabel
    \global\let\cam@lbl@ctr\@currentcounter}%
  \let\@currentlabel\cam@lbl@label
  \let\@currentlabelname\cam@lbl@name
  \let\@currentHref\cam@lbl@href
  \let\cref@currentlabel\cam@lbl@cref
  \let\@currentcounter\cam@lbl@ctr}

%% Caption dispatch. Both levels come through \caption, but telling them apart
%% is not as simple as reading \@captype: subcaption marks a subfloat with a
%% caption-package flag (\captionsetup{subtype}) and leaves \@captype at
%% `figure', so inside a subfigure \@captype still says figure. Hence the
%% explicit \ifcam@insub, set by the subfloat patch below. It is set inside the
%% subfloat's minipage group, so it unsets itself when the subfloat ends.
\newcommand{\cam@caption}{%
  \@ifnextchar[{\cam@caption@opt}{\cam@caption@noopt}}
\def\cam@caption@opt[#1]#2{\cam@caption@do{#1}{#2}}
\def\cam@caption@noopt#1{\cam@caption@do{}{#1}}
%% Both emitters call the \caption that was in force at the point they hook,
%% NOT the \cam@origcaption saved in the preamble. The caption package
%% specialises \caption per float (and again per subfloat), and part of that
%% specialisation decides whether the float's counter still needs stepping.
%% Calling the preamble copy bypasses it, and the float counter gets stepped a
%% second time: subfloats of Figure 3.2 came out labelled 3.1a, 3.1b, and every
%% figure after a subfigured one was numbered one too high.
\newcommand{\cam@emitcaption}[2]{%
  \ifstrempty{#1}{\cam@floatcmd{#2}}{\cam@floatcmd[#1]{#2}}}
\newif\ifcam@insub
\newcommand{\cam@caption@do}[2]{%
  \ifcam@insub
    \cam@subcaption@do{#1}{#2}%
  \else
    \ifthenelse{\equal{\@captype}{figure} \OR \equal{\@captype}{table}}%
      {\cam@mkcolbox{\cam@emitcaption{#1}{#2}}%
       \global\setbox\cam@capbox=\box\cam@tmpbox
       \global\cam@hascaptrue}%
      {\cam@emitcaption{#1}{#2}}%
  \fi}

%% Subcaption: the description is boxed for the margin column; only the label
%% is printed under the subfloat it belongs to.
\newcommand{\cam@emitsubcaption}[2]{%
  \ifstrempty{#1}{\cam@subcmd{#2}}{\cam@subcmd[#1]{#2}}}
\newcommand{\cam@subcaption@do}[2]{%
  \cam@mkcolbox{\cam@emitsubcaption{#1}{#2}}%
  \ifcam@hassub
    \global\setbox\cam@subbox=\vbox{\unvbox\cam@subbox
                                    \vskip0.5\baselineskip
                                    \unvbox\cam@tmpbox}%
  \else
    \global\setbox\cam@subbox=\box\cam@tmpbox
    \global\cam@hassubtrue
  \fi
  %% The counter was stepped inside the box above (LaTeX counters are global),
  %% so \thesubfigure is now this subfloat's letter.
  \par\centering{\footnotesize(\thesubfigure)}\par}

%% Float body capture and side-by-side assembly.
%%
%% \cam@startfloat CANNOT be installed with \AtBeginEnvironment{figure}: that
%% hook fires before \@float has looked ahead for the [htb] optional argument,
%% so the hook's tokens are what \@ifnextchar sees. The placement specifier is
%% then typeset as literal text and \@xfloat runs inside our \vbox, where it
%% dies with "Not in outer par mode". Appending to \@xfloat instead puts the
%% hook inside the float box, after \@floatboxreset, which is exactly where the
%% body starts. \@captype is set by then, so the same hook serves every float
%% class and can decline the ones it should not touch.
\newif\ifcam@boxed
\newcommand{\cam@startfloat}{%
  \global\cam@boxedfalse
  \ifthenelse{\equal{\@captype}{figure} \OR \equal{\@captype}{table}}%
    {\global\cam@boxedtrue
     \global\cam@hascapfalse
     \global\cam@hassubfalse
     \let\cam@floatcmd\caption
     \let\caption\cam@caption
     \setbox\cam@bodybox=\vbox\bgroup
       \hsize=\textwidth
       \linewidth=\hsize \columnwidth=\hsize
       \@parboxrestore}%
    {}}
\newcommand{\cam@endfloat}{%
  \ifcam@boxed
    \egroup
    \ifcam@hascap
      \global\setbox\cam@capbox=\vbox{%
        \unvbox\cam@capbox
        \ifcam@hassub \vskip0.6\baselineskip \unvbox\cam@subbox \fi}%
    \else
      \ifcam@hassub
        \global\setbox\cam@capbox=\box\cam@subbox
        \global\cam@hascaptrue
      \fi
    \fi
    \noindent
    \ifcam@hascap
      %% \hss absorbs the overhang into the margin without an overfull warning.
      \hbox to\textwidth{\vtop{\unvbox\cam@bodybox}%
                         \hskip\marginparsep
                         \vtop{\unvbox\cam@capbox}\hss}%
    \else
      \unvbox\cam@bodybox
    \fi
    \global\cam@boxedfalse
  \fi}

%% Same story one level down. \AtBeginEnvironment{subfigure} is no good for
%% the same reason it was no good for figure: subcaption's environment looks
%% ahead for the [b] and {width} arguments, so the hook's tokens arrive before
%% the minipage exists -- and the minipage's \@parboxrestore then puts \caption
%% back to the caption package's own. \subcaption@iiminipage is the point after
%% the minipage has been opened, which is where the rebinding survives.
\apptocmd{\@xfloat}{\cam@startfloat}{}{%
  \PackageWarning{packages}{Could not patch \string\@xfloat;
                            margin captions disabled}}
\apptocmd{\subcaption@iiminipage}{%
  \cam@insubtrue
  %% \caption inside a subfloat is NOT the top-level \caption: subcaption
  %% installs a subfloat-aware one that numbers against the subfigure counter.
  %% Save it before overwriting, and call the saved one to typeset the
  %% subcaption -- calling the top-level \caption instead silently numbers
  %% every subfloat as a new figure ("Figure (3)" for what should be "(b)").
  \let\cam@subcmd\caption
  \let\caption\cam@caption}{}{%
  \PackageWarning{packages}{Could not patch \string\subcaption@iiminipage;
                            subcaptions stay under their subfloat}}
\AtBeginDocument{%
  \AtEndEnvironment{figure}{\cam@endfloat}%
  \AtEndEnvironment{figure*}{\cam@endfloat}%
  \AtEndEnvironment{table}{\cam@endfloat}%
  \AtEndEnvironment{table*}{\cam@endfloat}%
  \AtBeginEnvironment{wrapfigure}{\let\caption\cam@origcaption}%
  \AtBeginEnvironment{wraptable}{\let\caption\cam@origcaption}%
  \AtBeginEnvironment{longtable}{\let\caption\cam@origcaption}%
}
\makeatother

