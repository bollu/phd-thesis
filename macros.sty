%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \texttt carries the same inline-code tint as \leaninline (see the note in
%% packages.sty). Declared robust because \texttt appears in section titles and
%% captions, which are written to the .aux and re-read for the ToC and the
%% running heads. Defined last so that it also catches the tool-name macros
%% (\bvdecide, \bvnormalize, ...), which expand to \texttt.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% \texttt is ALREADY robust (\DeclareTextFontCommand), so \texttt expands to
%% "\protect\texttt<space>" and the real definition lives in \csname texttt
%% <space>\endcsname. \let-ting the outer name therefore captures the protected
%% shell, which after the redefinition below points back at the new \texttt --
%% infinite recursion, which TeX reports as "grouping levels=255" the moment
%% the .toc is read back. Grab the inner command instead.
\makeatletter
\expandafter\let\expandafter\cam@plaintexttt\csname texttt \endcsname
\DeclareRobustCommand{\texttt}[1]{\cam@codetint{\cam@plaintexttt{#1}}}
\makeatother
