%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Lean / LLVM listings via minted.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Colour scheme. Everything was previously `style=bw' -- bold for keywords and
%% nothing else -- which makes a 20-line Lean listing an undifferentiated grey
%% block. `lovelace' is pygments' print-oriented style: desaturated blue
%% keywords (not bold, so the block keeps an even colour), grey italic
%% comments, green italic operators, dark red literals. It is the only stock
%% style muted enough to sit on a page set in Cochineal without shouting.
%%
%% NB: minted 3 resolves styles by name from pygments' installed set; custom
%% style classes cannot be registered the way tools/lexers/Lean4Lexer.py is
%% (latexminted's .latexminted_config supports custom_lexers only). So the
%% scheme has to be chosen from the stock list rather than tuned to Accent.
%%
%% The style itself is set once, globally, by \usemintedstyle in packages.sty;
%% the per-environment `style=' options that used to pin bw are gone so that
%% there is a single place to change it.
\newminted[llvm]{llvm}{fontsize=\footnotesize}
\newminted[ccode]{text}{fontsize=\footnotesize}

% Lean listings use the custom Lean 4 lexer (tools/lexers/Lean4Lexer.py,
% registered in .latexminted_config) rather than pygments' built-in Lean 3
% 'lean' lexer.
%
% Custom-lexer invocation differs by minted generation, so we select the lexer
% spec (\lexLean) and the shared option prefix (\clopt) once:
%   * minted 3.x  -- reference the lexer file by "path:Class", no extra option
%                    (authorization comes from .latexminted_config).
%   * minted 2.x  -- newer builds take the 'customlexer' option; older builds
%                    need '-x' appended to the lexer path instead.
\makeatletter
\@ifpackagelater{minted}{2024/06/01}
  {\newcommand{\lexLean}{tools/lexers/Lean4Lexer.py:Lean4Lexer}%
   \newcommand{\clopt}{}}
  {\ifcsdef{minted@optlistcl@quote}
    {\newcommand{\lexLean}{tools/lexers/Lean4Lexer.py:Lean4Lexer}%
     \newcommand{\clopt}{customlexer, }}
    {\newcommand{\lexLean}{tools/lexers/Lean4Lexer.py:Lean4Lexer -x}%
     \newcommand{\clopt}{}}}
%% No background tint, and \footnotesize throughout -- the settings the
%% background chapter's listings already used, which read better than the
%% tinted \small the rest of the document had. The tint was doing the job of
%% saying "this is code"; the mono face and the colour scheme say it more
%% quietly, and a full-width panel of tint on every other page is heavy.
\newminted[lean]{\lexLean}{\clopt fontsize=\footnotesize}
\newminted[lean4]{\lexLean}{\clopt mathescape, fontsize=\footnotesize}
\newminted[leanfootnotesize]{\lexLean}{\clopt fontsize=\footnotesize, escapeinside=@@, mathescape}
\newcommand{\leaninline}[1]{\mintinline[\clopt bgcolor=CodeBg]{\lexLean}{#1}}
\newcommand{\leaninlineM}[1]{\text{\mintinline[\clopt bgcolor=CodeBg]{\lexLean}{#1}}}
\makeatother

